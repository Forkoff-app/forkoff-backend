# Server
PORT=3000
NODE_ENV=development

# Supabase PostgreSQL - UPDATE THESE WITH YOUR CREDENTIALS
# Get these from your Supabase project settings > Database
# Connection string (pooling) — used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connection string (direct) — used by Prisma for migrations/schema push
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public&sslmode=require"

# Supabase Auth - UPDATE THESE WITH YOUR CREDENTIALS
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# JWT (use Supabase JWT secret from project settings > API)
JWT_SECRET=your-jwt-secret

# Device Pairing
PAIRING_CODE_EXPIRY_MINUTES=10

# CORS (comma-separated origins, leave empty for development)
# ALLOWED_ORIGINS=https://forkoff.app

# Admin (comma-separated emails for admin endpoints)
# ADMIN_EMAILS=admin@example.com
# ADMIN_API_KEY=your-admin-api-key

# Logging (optional, defaults to 'info')
# LOG_LEVEL=debug
