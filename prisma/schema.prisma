// Prisma schema for ForkOff API
// Using Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model - synced with Supabase Auth
model User {
  id               String        @id @default(uuid())
  email            String        @unique
  username         String?       @unique
  name             String?
  avatarUrl        String?
  country          String?
  countryUpdatedAt DateTime?
  timezone         String?       @default("UTC")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  devices          Device[]
  promptQueue      PromptQueueItem[]
  tokenUsageDaily  TokenUsageDaily[]
  achievements     UserAchievement[]
  queueSchedule    QueueSchedule?
  deviceFingerprints DeviceFingerprint[]

  @@map("users")
}

// Device model - represents a connected development machine
model Device {
  id             String          @id @default(uuid())
  userId         String?         // Nullable for unpaired devices
  name           String
  type           DeviceType
  platform       Platform
  status         DeviceStatus    @default(OFFLINE)
  lastSeenAt     DateTime?
  pairingCode    String?         @unique
  pairingExpires DateTime?
  hostname       String?
  osVersion      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // E2EE (End-to-End Encryption)
  publicKeyX25519   String?   // X25519 public key for E2EE (Base64)
  e2eeKeyVersion    Int       @default(0)  // 0 = no E2EE, 1+ = active

  // Relations
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedTools DeviceTool[]
  claudeSessions ClaudeSession[]

  @@index([userId])
  @@index([pairingCode])
  @@map("devices")
}

// Tools connected to a device (Cursor, Claude Terminal, Copilot, etc.)
model DeviceTool {
  id        String     @id @default(uuid())
  deviceId  String
  type      ToolType
  name      String
  version   String?
  status    ToolStatus @default(INACTIVE)
  config    Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  device    Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, type])
  @@map("device_tools")
}

// Claude Code session tracking
model ClaudeSession {
  id              String                @id @default(uuid())
  deviceId        String
  sessionKey      String                // Our session key for routing
  directory       String                // Working directory where session was started
  name            String?               // Auto-set from first user message as session summary
  state           ClaudeSessionState    @default(INACTIVE)
  lastUsedAt      DateTime              @default(now())
  transcriptPath  String?               // Path to Claude's transcript file (null for SDK streaming)
  claudeSessionId String?               // Claude CLI's internal session ID for resume
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Relations
  device          Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  messages        ClaudeSessionMessage[]

  @@unique([deviceId, sessionKey])
  @@index([deviceId])
  @@map("claude_sessions")
}

// Messages for Claude SDK streaming sessions
model ClaudeSessionMessage {
  id              String         @id @default(uuid())
  sessionId       String
  messageId       String         // Client-generated message ID for deduplication
  type            String         // user, assistant, tool_use, tool_result, system, result
  content         String?        // Text content
  toolName        String?        // For tool_use/tool_result
  toolInput       Json?          // For tool_use
  isError         Boolean        @default(false)
  timestamp       DateTime       @default(now())

  // Relations
  session         ClaudeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, messageId])
  @@index([sessionId])
  @@map("claude_session_messages")
}

enum ClaudeSessionState {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Enums
enum DeviceType {
  LAPTOP
  DESKTOP
  SERVER
}

enum Platform {
  MACOS
  WINDOWS
  LINUX
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  SYNCING
}

enum ToolType {
  CURSOR
  CLAUDE_TERMINAL
  CLAUDE_CODE
  COPILOT
  WINDSURF
  CONTINUE
}

enum ToolStatus {
  ACTIVE
  INACTIVE
  ERROR
}

// Push notification tokens for mobile devices
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  platform  String   // ios, android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@map("push_tokens")
}

// App configuration (min version, feature flags, etc.)
model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_config")
}

// Prompt Queue Item - for queuing prompts during rate limits
model PromptQueueItem {
  id              String    @id @default(uuid())
  userId          String
  deviceId        String
  sessionKey      String?
  prompt          String
  status          String    @default("PENDING") // PENDING, SCHEDULED, EXECUTING, COMPLETED, FAILED, CANCELLED
  priority        Int       @default(0)
  rateLimitReason String?
  retryAfter      DateTime?
  scheduledFor    DateTime?
  executedAt      DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([scheduledFor])
  @@map("prompt_queue_items")
}

// Queue Schedule Configuration (user's local time preferences)
model QueueSchedule {
  id            String   @id @default(uuid())
  userId        String   @unique
  enabled       Boolean  @default(false)
  scheduledTime String   // HH:mm format in user's timezone
  daysOfWeek    Int[]    // 0=Sunday, 1=Monday, etc. Empty = every day
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("queue_schedules")
}

// Daily Token Usage Aggregation
model TokenUsageDaily {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @db.Date
  inputTokens      BigInt   @default(0)
  outputTokens     BigInt   @default(0)
  sessionCount     Int      @default(0)
  estimatedCostUsd Decimal? @db.Decimal(10, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("token_usage_daily")
}

// Achievement Definitions (seeded)
model Achievement {
  id               String            @id @default(uuid())
  key              String            @unique // e.g., "tokens_1m", "sessions_100"
  name             String
  description      String
  category         String            // TOKENS, SESSIONS, ENGAGEMENT, SPECIAL
  iconName         String            // Lucide icon name
  tier             String            // BRONZE, SILVER, GOLD, PLATINUM, DIAMOND
  threshold        BigInt
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]

  @@map("achievements")
}

// User's earned achievements
model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  progress      BigInt      @default(0)
  showcased     Boolean     @default(false)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// Device fingerprint for one-account-per-device enforcement
model DeviceFingerprint {
  id              String   @id @default(uuid())
  fingerprintHash String   // SHA-256 of hardware identifiers
  userId          String
  registeredAt    DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fingerprintHash])
  @@map("device_fingerprints")
}

model ClaudeAccount {
  id                  String        @id @default(uuid())
  name                String        @unique
  encryptedOauthToken String
  inviteCode          String?       @unique
  disabled            Boolean       @default(false)
  lastUsedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  users               GatewayUser[]

  @@map("claude_accounts")
}

model GatewayUser {
  id              String        @id @default(uuid())
  username        String        @unique
  passwordHash    String
  claudeAccountId String
  disabled        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  claudeAccount   ClaudeAccount @relation(fields: [claudeAccountId], references: [id])
  keys            GatewayKey[]

  @@map("gateway_users")
}

model GatewayKey {
  id         String      @id @default(uuid())
  userId     String
  hashedKey  String      @unique
  label      String?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())
  user       GatewayUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gateway_keys")
}

// Cloud relay pairing persistence (survives server restarts)
model CloudPairing {
  id               String   @id @default(uuid())
  cliDeviceHash    String   @unique  // SHA-256 truncated hash of cliDeviceId
  mobileDeviceHash String            // SHA-256 truncated hash of mobileDeviceId
  cliRelayToken    String            // CSPRNG 32-byte hex token
  mobileRelayToken String            // CSPRNG 32-byte hex token
  pairId           String   @unique
  expoPushToken    String?           // Expo push notification token from paired mobile
  pushPlatform     String?           // ios | android
  createdAt        DateTime @default(now())

  @@index([mobileDeviceHash])
  @@map("cloud_pairings")
}
