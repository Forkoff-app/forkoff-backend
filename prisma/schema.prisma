// Prisma schema for ForkOff API
// Using Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model - synced with Supabase Auth
model User {
  id               String        @id @default(uuid())
  email            String        @unique
  username         String?       @unique
  name             String?
  avatarUrl        String?
  subscription     String        @default("free") // free, pro, team
  proExpiresAt     DateTime?     // When PRO subscription expires (for voucher/referral benefits)
  isLifetimePro    Boolean       @default(false) // Permanent PRO access from lifetime voucher
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  country          String?
  countryUpdatedAt DateTime?
  timezone         String?       @default("UTC")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  devices          Device[]
  projects         Project[]
  chatSessions     ChatSession[]
  promptQueue      PromptQueueItem[]
  tokenUsageDaily  TokenUsageDaily[]
  achievements     UserAchievement[]
  queueSchedule    QueueSchedule?
  subscriptionUsage SubscriptionUsage?
  phoneSession     PhoneSession?
  voucherRedemptions VoucherRedemption[]
  referralProfile  ReferralProfile?
  referredBy       Referral?     @relation("ReferredUser")

  @@map("users")
}

// Device model - represents a connected development machine
model Device {
  id             String          @id @default(uuid())
  userId         String?         // Nullable for unpaired devices
  name           String
  type           DeviceType
  platform       Platform
  status         DeviceStatus    @default(OFFLINE)
  lastSeenAt     DateTime?
  pairingCode    String?         @unique
  pairingExpires DateTime?
  hostname       String?
  osVersion      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedTools DeviceTool[]
  projects       Project[]
  claudeSessions ClaudeSession[]

  @@index([userId])
  @@index([pairingCode])
  @@map("devices")
}

// Tools connected to a device (Cursor, Claude Terminal, Copilot, etc.)
model DeviceTool {
  id        String     @id @default(uuid())
  deviceId  String
  type      ToolType
  name      String
  version   String?
  status    ToolStatus @default(INACTIVE)
  config    Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  device    Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, type])
  @@map("device_tools")
}

// Claude Code session tracking
model ClaudeSession {
  id              String                @id @default(uuid())
  deviceId        String
  sessionKey      String                // Our session key for routing
  directory       String                // Working directory where session was started
  name            String?               // Auto-set from first user message as session summary
  state           ClaudeSessionState    @default(INACTIVE)
  lastUsedAt      DateTime              @default(now())
  transcriptPath  String?               // Path to Claude's transcript file (null for SDK streaming)
  claudeSessionId String?               // Claude CLI's internal session ID for resume
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Relations
  device          Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  messages        ClaudeSessionMessage[]

  @@unique([deviceId, sessionKey])
  @@index([deviceId])
  @@map("claude_sessions")
}

// Messages for Claude SDK streaming sessions
model ClaudeSessionMessage {
  id              String         @id @default(uuid())
  sessionId       String
  messageId       String         // Client-generated message ID for deduplication
  type            String         // user, assistant, tool_use, tool_result, system, result
  content         String?        // Text content
  toolName        String?        // For tool_use/tool_result
  toolInput       Json?          // For tool_use
  isError         Boolean        @default(false)
  timestamp       DateTime       @default(now())

  // Relations
  session         ClaudeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, messageId])
  @@index([sessionId])
  @@map("claude_session_messages")
}

enum ClaudeSessionState {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Project model
model Project {
  id           String        @id @default(uuid())
  userId       String
  deviceId     String
  name         String
  path         String
  language     String?
  framework    String?
  description  String?
  lastModified DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@index([userId])
  @@index([deviceId])
  @@map("projects")
}

// Chat session with AI tools
model ChatSession {
  id            String        @id @default(uuid())
  userId        String
  projectId     String
  toolType      ToolType
  title         String        @default("New Chat")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@index([userId])
  @@index([projectId])
  @@map("chat_sessions")
}

// Chat message
model ChatMessage {
  id              String          @id @default(uuid())
  sessionId       String
  role            MessageRole
  content         String
  status          MessageStatus   @default(COMPLETE)
  timestamp       DateTime        @default(now())

  // Relations
  session         ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest?

  @@index([sessionId])
  @@map("chat_messages")
}

// Approval request from AI tool
model ApprovalRequest {
  id          String              @id @default(uuid())
  messageId   String              @unique
  type        ApprovalType
  description String
  changes     Json                // Array of code changes
  status      ApprovalStatus      @default(PENDING)
  requestedAt DateTime            @default(now())
  respondedAt DateTime?

  // Relations
  message     ChatMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("approval_requests")
}

// Enums
enum DeviceType {
  LAPTOP
  DESKTOP
  SERVER
}

enum Platform {
  MACOS
  WINDOWS
  LINUX
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  SYNCING
}

enum ToolType {
  CURSOR
  CLAUDE_TERMINAL
  CLAUDE_CODE
  COPILOT
  WINDSURF
  CONTINUE
}

enum ToolStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETE
  ERROR
}

enum ApprovalType {
  FILE_CHANGE
  FILE_CREATION
  FILE_DELETION
  COMMAND_EXECUTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Voucher system enums
enum VoucherType {
  LIFETIME_PRO  // Permanent PRO access
  CAMPAIGN      // Limited redemptions (e.g., 200 users)
  SINGLE_USE    // One-time randomly generated
}

enum VoucherBenefitType {
  FREE_MONTHS      // X months of PRO
  LIFETIME_PRO     // Permanent PRO
  DISCOUNT_PERCENT // Future payment integration
}

// Push notification tokens for mobile devices
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  platform  String   // ios, android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@map("push_tokens")
}

// App configuration (min version, feature flags, etc.)
model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_config")
}

// Prompt Queue Item - for queuing prompts during rate limits
model PromptQueueItem {
  id              String    @id @default(uuid())
  userId          String
  deviceId        String
  sessionKey      String?
  prompt          String
  status          String    @default("PENDING") // PENDING, SCHEDULED, EXECUTING, COMPLETED, FAILED, CANCELLED
  priority        Int       @default(0)
  rateLimitReason String?
  retryAfter      DateTime?
  scheduledFor    DateTime?
  executedAt      DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([scheduledFor])
  @@map("prompt_queue_items")
}

// Queue Schedule Configuration (user's local time preferences)
model QueueSchedule {
  id            String   @id @default(uuid())
  userId        String   @unique
  enabled       Boolean  @default(false)
  scheduledTime String   // HH:mm format in user's timezone
  daysOfWeek    Int[]    // 0=Sunday, 1=Monday, etc. Empty = every day
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("queue_schedules")
}

// Daily Token Usage Aggregation
model TokenUsageDaily {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @db.Date
  inputTokens      BigInt   @default(0)
  outputTokens     BigInt   @default(0)
  sessionCount     Int      @default(0)
  estimatedCostUsd Decimal? @db.Decimal(10, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("token_usage_daily")
}

// Achievement Definitions (seeded)
model Achievement {
  id               String            @id @default(uuid())
  key              String            @unique // e.g., "tokens_1m", "sessions_100"
  name             String
  description      String
  category         String            // TOKENS, SESSIONS, ENGAGEMENT, SPECIAL
  iconName         String            // Lucide icon name
  tier             String            // BRONZE, SILVER, GOLD, PLATINUM, DIAMOND
  threshold        BigInt
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]

  @@map("achievements")
}

// User's earned achievements
model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  progress      BigInt      @default(0)
  showcased     Boolean     @default(false)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// Subscription usage tracking
model SubscriptionUsage {
  id                     String   @id @default(uuid())
  userId                 String   @unique

  // Daily counters (reset at midnight UTC)
  messagesUsedToday      Int      @default(0)
  messageLimitResetAt    DateTime @default(now())

  // Monthly counters (reset on 1st of month)
  sessionsUsedThisMonth  Int      @default(0)
  repairsUsedThisMonth   Int      @default(0)
  monthlyLimitResetAt    DateTime @default(now())

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription_usage")
}

// Active phone session tracking (Pro tier)
model PhoneSession {
  id           String   @id @default(uuid())
  userId       String   @unique  // Only one per user
  socketId     String
  deviceInfo   String?  // Device name/model
  connectedAt  DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("phone_sessions")
}

// Waitlist for pre-launch signups
model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist")
}

// Voucher definition
model Voucher {
  id                 String             @id @default(uuid())
  code               String             @unique
  type               VoucherType
  benefitType        VoucherBenefitType
  benefitValue       Int                @default(0) // Months for FREE_MONTHS, percentage for DISCOUNT
  maxRedemptions     Int?               // null = unlimited
  currentRedemptions Int                @default(0)
  validFrom          DateTime           @default(now())
  validUntil         DateTime?          // null = never expires
  campaignName       String?
  description        String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  redemptions        VoucherRedemption[]

  @@index([code])
  @@index([isActive])
  @@map("vouchers")
}

// Voucher redemption record
model VoucherRedemption {
  id               String             @id @default(uuid())
  voucherId        String
  userId           String
  benefitType      VoucherBenefitType
  benefitValue     Int
  benefitExpiresAt DateTime?          // When the benefit expires (for FREE_MONTHS)
  redeemedAt       DateTime           @default(now())
  voucher          Voucher            @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([voucherId, userId])
  @@index([userId])
  @@map("voucher_redemptions")
}

// User's referral profile
model ReferralProfile {
  id                  String     @id @default(uuid())
  userId              String     @unique
  referralCode        String     @unique
  totalReferrals      Int        @default(0)
  successfulReferrals Int        @default(0)
  rewardMonthsEarned  Int        @default(0)
  rewardMonthsClaimed Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals           Referral[] @relation("ReferrerProfile")

  @@index([referralCode])
  @@map("referral_profiles")
}

// Individual referral record
model Referral {
  id                String          @id @default(uuid())
  referrerProfileId String
  referredUserId    String          @unique
  signedUpAt        DateTime        @default(now())
  convertedAt       DateTime?
  isConverted       Boolean         @default(false)
  rewardGranted     Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  referrerProfile   ReferralProfile @relation("ReferrerProfile", fields: [referrerProfileId], references: [id], onDelete: Cascade)
  referredUser      User            @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerProfileId])
  @@map("referrals")
}
